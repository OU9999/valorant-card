# ===========================================
# 테스트 모드
# ===========================================

# /test/* 페이지 접근 제어
# 정확히 "true"로 설정해야 활성화 (1, yes, on 등은 불가)
# 프로덕션 환경에서는 이 변수를 설정하지 않거나 제거하세요
APP_ENV=

# ===========================================
# Riot Games API
# ===========================================

# Riot Games 개발자 포털에서 발급받은 API 키
# 발급: https://developer.riotgames.com
# 주의: Development 키는 24시간마다 만료됨
RIOT_API_KEY=

# ===========================================
# 리전 & 샤드 설정
# ===========================================

# Riot 계정 리전 (라우팅 값)
# 옵션: americas | asia | europe | esports
RIOT_REGION=

# Valorant 샤드 (게임 데이터 서버)
# 옵션: kr | ap | br | eu | latam | na
VALORANT_SHARD=

# ===========================================
# 세션 (iron-session)
# ===========================================

# 세션 암호화 비밀번호 (32자 이상 필수)
# 생성: openssl rand -hex 32
# 주의: 배포 간 동일한 값 유지 필요 (변경 시 기존 세션 무효화)
IRON_SESSION_PASSWORD=

# 세션 쿠키 이름 (기본값: vfc_session)
# IRON_SESSION_COOKIE_NAME=vfc_session

# ===========================================
# RSO (Riot Sign On) OAuth — Production Key 승인 후 활성화
# ===========================================

# Riot Developer Portal에서 발급받은 OAuth 자격증명
# placeholder 상태에서는 RSO 라우트가 503 반환
RSO_CLIENT_ID=placeholder
RSO_CLIENT_SECRET=placeholder

# OAuth 콜백 URL (배포 시 실제 도메인으로 변경)
RSO_REDIRECT_URI=http://localhost:3000/api/auth/rso/callback

# ===========================================
# Henrik Valorant API (비공식)
# ===========================================

# Henrik API 키 (Discord에서 발급)
# 발급: https://discord.gg/X3GaVkX2YN → #get-a-key
HDEV_API_KEY=
